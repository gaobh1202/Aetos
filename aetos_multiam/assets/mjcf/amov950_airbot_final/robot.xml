<!--
  Standalone AMOV quadrotor + Airbot Play arm for Isaac Sim / MuJoCo.
  Source: quadrotor_950_arm_carrier.xml (no cross-file includes).
  Mesh paths are absolute under: /home/benhua/raids-am-simulator
  Isaac Sim: import amov_drone_arm.urdf (repo root) via URDF Importer, Fix Base=OFF.
-->
<mujoco model="amov_drone_arm">
  <compiler angle="radian" autolimits="true" meshdir="../../meshes/mjcf/amov950_airbot_final"/>
  <option gravity="0 0 0" timestep="0.002" integrator="implicitfast"/>

  <default>
    <default class="rcdrone">
      <default class="drone_visual">
        <geom group="2" type="mesh" contype="0" conaffinity="0"/>
      </default>
    </default>
    <default class="aribot_play">
      <default class="visual">
        <geom group="2" type="mesh" contype="0" conaffinity="0"/>
      </default>
      <default class="collision">
        <geom group="3" condim="6" solimp="2 1 0.01" solref="0.001 10" friction="1 0.005 0.0001" type="mesh"/>
      </default>
      <default class="joint1">
        <joint axis="0 0 1" range="-3.151 2.089" actuatorfrcrange="-24 24" damping="0.2" frictionloss="15"/>
        <position ctrlrange="-3.151 2.089"/>
      </default>
      <default class="joint2">
        <joint axis="0 0 1" range="-2.963 0.181" actuatorfrcrange="-24 24" damping="0.2" frictionloss="15"/>
        <position ctrlrange="-2.963 0.181"/>
      </default>
      <default class="joint3">
        <joint axis="0 0 1" range="-0.094 3.161" actuatorfrcrange="-24 24" damping="0.2" frictionloss="15"/>
        <position ctrlrange="-0.094 3.161"/>
      </default>
      <default class="joint4">
        <joint axis="0 0 1" range="-3.012 3.012" actuatorfrcrange="-8 8" damping="0.1" frictionloss="5"/>
        <position ctrlrange="-3.012 3.012"/>
      </default>
      <default class="joint5">
        <joint axis="0 0 1" range="-1.859 1.859" actuatorfrcrange="-8 8" damping="0.1" frictionloss="5"/>
        <position ctrlrange="-1.859 1.859"/>
      </default>
      <default class="joint6">
        <joint axis="0 0 1" range="-3.017 3.017" actuatorfrcrange="-8 8" damping="0.1" frictionloss="5"/>
        <position ctrlrange="-3.017 3.017"/>
      </default>
      <default class="finger1">
        <joint axis="0 1 0" range="-0.04 0" type="slide" damping="1"/>
      </default>
      <default class="finger2">
        <joint axis="0 1 0" range="0 0.04" type="slide" damping="1"/>
      </default>
    </default>
    <site size="0.001" group="3"/>
  </default>

  <asset>
    <material name="paint_metallic_dark" specular="0.4" shininess="0.6" rgba="0.1 0.1 0.1 1"/>
    <material name="Paint_Matte_Black" specular="0.5" shininess="0.5" rgba="0.00111266039 0.00111266039 0.00111266039 1.0"/>
    <material name="Paint_Metallic_White" specular="0.5" shininess="0.5" rgba="0.928523183 0.928523183 0.928523123 1.0"/>
    <material name="Gree_Light_Base" specular="0.5" shininess="0.5" rgba="0.6 1 1 1"/>
    <mesh name="quadrotor_950_base" file="assets/drone/quadrotor_950.stl" scale="1 1 1"/>
    <mesh name="arm_base_0" file="assets/arm/arm_base_0.obj"/>
    <mesh name="arm_base_1" file="assets/arm/arm_base_1.obj"/>
    <mesh name="link1" file="assets/arm/link1.obj"/>
    <mesh name="link2_0" file="assets/arm/link2_0.obj"/>
    <mesh name="link2_1" file="assets/arm/link2_1.obj"/>
    <mesh name="link3_0" file="assets/arm/link3_0.obj"/>
    <mesh name="link3_1" file="assets/arm/link3_1.obj"/>
    <mesh name="link4" file="assets/arm/link4.obj"/>
    <mesh name="link5_0" file="assets/arm/link5_0.obj"/>
    <mesh name="link5_1" file="assets/arm/link5_1.obj"/>
    <mesh name="link6" file="assets/arm/link6.obj"/>
    <mesh name="camera_stand" file="assets/arm/camera_stand.obj"/>
    <mesh name="left" file="assets/arm/left.obj"/>
    <mesh name="right" file="assets/arm/right.obj"/>
  </asset>

  <worldbody>
    <body name="quadrotor_950_pos" pos="0 0 0">
      <body name="quadrotor_950" pos="0 0 0" childclass="rcdrone">
        <inertial pos="0 0 0" quat="1 0 0 0" mass="6.5" diaginertia="0.2198 0.2198 0.3197"/>
        <geom mesh="quadrotor_950_base" pos="0 0 0" material="paint_metallic_dark" class="drone_visual"/>
        <site name="qcX" type="box" pos="0.1 0 0" size="0.15 0.005 0.005" quat="1 0 0 0" rgba="1 0 0 1"/>
        <site name="qcY" type="box" pos="0 0.1 0" size="0.15 0.005 0.005" quat="0.707 0 0 0.707" rgba="0 1 0 1"/>
        <site name="qcZ" type="box" pos="0 0 0.1" size="0.15 0.005 0.005" quat="-0.707 0 0.707 0" rgba="0 0 1 1"/>
        <geom name="thruster-a00" type="cylinder" pos="0.336 0.336 0.065" size="0.28 0.0025" quat="1 0 0 0" rgba="1 1 1 0.7"/>
        <geom name="thruster-a10" type="cylinder" pos="0.336 -0.336 0.065" size="0.28 0.0025" quat="1 0 0 0" rgba="1 1 1 0.7"/>
        <geom name="thruster-a20" type="cylinder" pos="-0.336 0.336 0.065" size="0.28 0.0025" quat="1 0 0 0" rgba="1 1 1 0.7"/>
        <geom name="thruster-a30" type="cylinder" pos="-0.336 -0.336 0.065" size="0.28 0.0025" quat="1 0 0 0" rgba="1 1 1 0.7"/>
        <geom name="chassis-a00" type="cylinder" pos="0.336 0.336 -0.48" size="0.01 0.001" quat="1 0 0 0" rgba="0 1 1 0"/>
        <geom name="chassis-a10" type="cylinder" pos="0.336 -0.336 -0.48" size="0.01 0.001" quat="1 0 0 0" rgba="0 1 1 0"/>
        <geom name="chassis-a20" type="cylinder" pos="-0.336 0.336 -0.48" size="0.01 0.001" quat="1 0 0 0" rgba="0 1 1 0"/>
        <geom name="chassis-a30" type="cylinder" pos="-0.336 -0.336 -0.48" size="0.01 0.001" quat="1 0 0 0" rgba="0 1 1 0"/>
        <body name="arm_mount_link" pos="0.005561 -0.002454 -0.125" euler="3.1415926 0 0">
          <inertial pos="0 0 0" mass="1e-6" diaginertia="1e-12 1e-12 1e-12"/>
        <!-- Copyright (c) 2026 Polyu-ISE RAIDS Lab. All rights reserved. -->

        <!-- ======= AITBOT PLAY ======= -->
          <body name="arm_base" childclass="aribot_play">
            <site name="armbase"/>
            <!-- explicits inertial to prevent MuJoCo from auto-generating excessive mass/inertia from the base collision/visual geoms. -->
            <inertial pos="-0.016 0 0.038" mass="0.166077" diaginertia="0.000286 0.000511 0.000575"/>
            <geom type="box" pos="-0.02 0 0.005" size="0.0806 0.1375 0.0025" rgba="0.2 0.2 0.2 1" euler="0 0 1.5708" class="collision"/>
            <geom type="box" pos="-0.015 0 0.045" size="0.07 0.05 0.04" rgba="1 0 0 0.5" class="collision"/>
            <geom mesh="arm_base_0" pos="0 0 -0.0015" material="Gree_Light_Base" class="visual"/>
            <geom mesh="arm_base_1" material="Paint_Matte_Black" class="visual"/>
            <body name="link1" pos="0 0 0.1172">
              <inertial pos="7.9126e-05 -0.002527 -0.0041359" quat="0.696716 0.716558 0.0238919 -0.0236876" mass="0.54639" diaginertia="0.000346294 0.000325437 0.000286269"/>
              <joint name="joint1" class="joint1"/>
              <geom type="mesh" material="Paint_Matte_Black" mesh="link1" class="visual"/>
              <body name="link2" quat="0.135866 0.135867 -0.69393 0.693932">
                <inertial pos="0.22493 0.0047721 0.008023" quat="-0.210875 0.632473 -0.273056 0.693506" mass="0.64621" diaginertia="0.00516535 0.00505042 0.000418626"/>
                <joint name="joint2" class="joint2"/>
                <geom type="box" pos="0.08 0.015 0" euler="0 0 0.15" size="0.11 0.03 0.04" rgba="1 0 0 1" class="collision"/>
                <geom type="box" pos="0.235 0.015 0" euler="0 0 -0.3" size="0.065 0.025 0.045" rgba="1 0 0 1" class="collision"/>
                <geom mesh="link2_0" material="Paint_Matte_Black" class="visual"/>
                <geom mesh="link2_1" material="Paint_Metallic_White" class="visual"/>
                <body name="link3" pos="0.27009 0 0" quat="0.192144 0 0 -0.981367">
                  <inertial pos="0.16813 -5.5576e-05 0.0031184" quat="0.511278 0.488423 0.489191 0.510617" mass="0.26829" diaginertia="0.0031527 0.0030951 0.000239403"/>
                  <joint name="joint3" class="joint3"/>
                  <geom type="box" pos="0.13 0 0" size="0.13 0.025 0.025" rgba="1 0 0 1" class="collision"/>
                  <geom mesh="link3_0" material="Paint_Matte_Black" class="visual"/>
                  <geom mesh="link3_1" material="Paint_Metallic_White" class="visual"/>
                  <body name="link4" pos="0.29015 0 0" quat="-2.59734e-06 0.707105 2.59735e-06 0.707108">
                    <inertial pos="5.2436e-06 0.00040412 -0.03228" quat="0.999969 -0.000174762 -0.00792041 -6.98144e-05" mass="0.34876" diaginertia="0.000423574 0.000412 0.000126826"/>
                    <joint name="joint4" class="joint4"/>
                    <!-- <geom type="cylinder" pos="0 0 0" size="0.03 0.03" euler="1.5708 0 0" rgba="1 0 0 1" class="collision"/> -->
                    <geom type="mesh" material="Paint_Matte_Black" mesh="link4" class="visual"/>
                    <body name="link5" quat="0.707105 0.707108 0 0">
                      <inertial pos="8.3328e-06 0.026148 0.002525" quat="0.531568 0.4663 0.4663 0.531568" mass="0.36132" diaginertia="0.0004677 0.000432922 0.000178178"/>
                      <joint name="joint5" class="joint5"/>
                      <!-- <geom type="cylinder" pos="0 0.06 0" size="0.03 0.03" euler="1.5708 0 0" rgba="1 0 0 1" class="collision"/> -->
                      <geom mesh="link5_0" material="Paint_Matte_Black" class="visual"/>
                      <geom mesh="link5_1" material="Paint_Metallic_White" class="visual"/>
                      <body name="link6" pos="0 0.23645 0" quat="0.499998 -0.5 0.5 0.500002">
                        <body pos="-0.105 0 -0.12" euler="3.1416 0 1.5708">
                          <camera name="eye_arm" euler="-0.5236 0 0" fovy="72.5376526571421"/>
                        </body>
                        <inertial pos="-0.0047053 7.3857e-05 -0.12293" mass="0.53855" diaginertia="5e-05 5e-05 3.85e-05"/>
                        <joint name="joint6" class="joint6"/>
                        <!-- <geom type="cylinder" pos="0 0 -0.11" size="0.03 0.03" euler="0 0 0" rgba="1 0 0 1" class="collision"/> -->
                        <geom type="box" pos="0 0 -0.07" size="0.025 0.08 0.015" rgba="1 0 0 1" class="collision"/>
                        <geom type="mesh" material="Paint_Matte_Black" mesh="link6" class="visual"/>
                        <geom type="mesh" material="Paint_Matte_Black" mesh="camera_stand" class="visual"/>
                        <site name="endpoint" pos='0 0 0.015' euler="0 -1.5708 0"/>
                        <body name="left">
                          <inertial pos="-0.048742 0.0096369 0.00044322" quat="0.757393 0.0415116 0.0313705 0.650883" mass="0.0626" diaginertia="2.79281e-05 1.90181e-05 1.21737e-05"/>
                          <joint name="endleft" class='finger2'/>
                          <geom type="mesh" mesh="right" material="Paint_Matte_Black" class="visual"/>
                          <geom name="left_finger_pad" type="box" size=".00525 .002 .02" pos="0 0.002 0.005" rgba="1 0 0 1" class="collision"/>
                          <geom type="box" size=".015 .002 .018" pos="0 0.002 -0.035" rgba="1 0 0 1" class="collision"/>
                        </body>
                        <body name="right">
                          <inertial pos="-0.049039 -0.0096764 0.00038868" quat="0.650491 0.0296695 0.0398251 0.757889" mass="0.061803" diaginertia="2.74809e-05 1.88104e-05 1.19127e-05"/>
                          <joint name="endright" class='finger1'/>
                          <geom type="mesh" mesh="left" material="Paint_Matte_Black" class="visual"/>
                          <geom name="right_finger_pad" type="box" size=".00525 .002 .02" pos="0 -0.002 0.005" rgba="1 0 0 1" class="collision"/>
                          <geom type="box" size=".015 .002 .018" pos="0 -0.002 -0.035" rgba="1 0 0 1" class="collision"/>
                        </body>
                      </body>
                    </body>
                  </body>
                </body>
              </body>
            </body>
          </body>
        </body>
      </body>
      <joint name="main_joint" type="free" pos="0 0 0"/>
      <site name="thrust" type="box" pos="0 0 0" size="0.01 0.01 0.01" quat="1 0 0 0" rgba="0 1 1 0"/>
      <site name="rateX" type="box" pos="0 0 0" quat="1 0 0 0" size="0.01 0.01 0.01" rgba="0 1 1 0"/>
      <site name="rateY" type="box" pos="0 0 0" quat="1 0 0 0" size="0.01 0.01 0.01" rgba="0 1 1 0"/>
      <site name="rateZ" type="box" pos="0 0 0" quat="1 0 0 0" size="0.01 0.01 0.01" rgba="0 1 1 0"/>
      <site name="main_center" type="box" pos="0 0 0" size="0.01 0.01 0.01" quat="1 0 0 0" rgba="0 1 1 0"/>
    </body>
  </worldbody>

  <contact>
    <exclude body1="arm_base" body2="link2"/>
  </contact>

  <tendon>
    <fixed name="gripper_gear">
      <joint joint="endleft" coef="0.5"/>
      <joint joint="endright" coef="-0.5"/>
    </fixed>
  </tendon>

  <equality>
    <joint joint1="endleft" joint2="endright" polycoef="0 -1 0 0 0"/>
  </equality>

  <actuator>
    <motor name="motor_thrust" ctrllimited="true" ctrlrange="-200 200" gear="0 0 1 0 0 0" site="thrust"/>
    <motor name="motor_rateX" ctrllimited="true" ctrlrange="-20 20" gear="0 0 0 1 0 0" site="rateX"/>
    <motor name="motor_rateY" ctrllimited="true" ctrlrange="-20 20" gear="0 0 0 0 1 0" site="rateY"/>
    <motor name="motor_rateZ" ctrllimited="true" ctrlrange="-20 20" gear="0 0 0 0 0 1" site="rateZ"/>
    <position name="joint1" ctrllimited="true" ctrlrange="-3.151 2.089" joint="joint1" kp="1000" user="1" forcelimited="true" forcerange="-300 300"/>
    <position name="joint2" ctrllimited="true" ctrlrange="-2.963 0.181" joint="joint2" kp="1000" user="1" forcelimited="true" forcerange="-300 300"/>
    <position name="joint3" ctrllimited="true" ctrlrange="-0.094 3.161" joint="joint3" kp="1000" user="1" forcelimited="true" forcerange="-300 300"/>
    <position name="joint4" ctrllimited="true" ctrlrange="-3.012 3.012" joint="joint4" kp="350" user="1" forcelimited="true" forcerange="-300 300"/>
    <position name="joint5" ctrllimited="true" ctrlrange="-1.859 1.859" joint="joint5" kp="350" user="1" forcelimited="true" forcerange="-300 300"/>
    <position name="joint6" ctrllimited="true" ctrlrange="-3.017 3.017" joint="joint6" kp="100" user="1" forcelimited="true" forcerange="-300 300"/>
    <position name="gripper" tendon="gripper_gear" ctrllimited="true" ctrlrange="0 0.04" kp="30" user="1" forcelimited="true" forcerange="-15 15"/>
  </actuator>
</mujoco>
