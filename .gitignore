__pycache__/
*.pyc
*.pyo

# Hydra run logs from smoke tests, not source
outputs/

# All robot model binaries (USD + every MJCF bundle's mesh geometry +
# model demo videos) live under this one folder and are distributed via
# netdisk instead of git -- see docs/ASSETS.md for the download link and
# the exact layout. Everything else under aetos_multiam/assets/ (robot.xml/
# scene.xml, README/CONVERSION_NOTES, preview thumbnails, the small
# iris_650.yaml rotor-physics config, the extraction/build/render scripts)
# stays tracked normally.
aetos_multiam/assets/meshes/

.DS_Store
*.egg-info/
build/
dist/

# MuJoCo auto-writes this wherever a script is run from whenever it emits
# a warning (e.g. the hummingbird bundle's flexcomp "not rigid" warning) --
# not something any script here creates on purpose.
MUJOCO_LOG.TXT

# Regenerated by examples/01_combine_all_aerial_manipulators_mujoco.py --
# the preview PNGs next to it are committed, this merged XML isn't.
examples/all_five_combined.xml

# Per-device calibration data (homing offsets, per-joint min/max ticks) --
# specific to whichever physical leader arm was calibrated on this machine,
# not something to ship/share.
aetos_multiam/devices/.cache/

# Task-object model binaries (USD + meshes/textures), migrated from
# raids-am-simulator's shelf_grasp scene -- same netdisk-distribution
# convention as aetos_multiam/assets/meshes/ above, see docs/ASSETS.md.
aetos_multiam/objects/assets/

# Mission recordings rendered by examples/show_am_action.py -- the 3x GIFs
# next to them are committed (the README table embeds them), the ~11 MB
# source mp4s are not. Re-render with --video.
resources/*.mp4
