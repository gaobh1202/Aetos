# Hydra run logs from smoke tests, not source
outputs/

# All robot model binaries (USD + every MJCF bundle's mesh geometry +
# model demo videos) live under this one folder and are distributed via
# netdisk instead of git -- see docs/ASSETS.md for the download link and
# the exact layout. Everything else under aetos_multiam/assets/ (robot.xml/
# scene.xml, README/CONVERSION_NOTES, preview thumbnails, the small
# iris_650.yaml rotor-physics config, the extraction/build/render scripts)
# stays tracked normally.
aetos_multiam/assets/meshes/

.DS_Store
*.egg-info/
build/
dist/

# MuJoCo auto-writes this wherever a script is run from whenever it emits
# a warning (e.g. the hummingbird bundle's flexcomp "not rigid" warning) --
# not something any script here creates on purpose.
MUJOCO_LOG.TXT

