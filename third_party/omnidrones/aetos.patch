 import torch
 import torch.nn as nn
+from tensordict import TensorDict
 
 
 class RotorGroup(nn.Module):
@@ -51,16 +52,36 @@ class RotorGroup(nn.Module):
 
         self.requires_grad_(False)
 
-    def forward(self, cmds: torch.Tensor):
+    def forward(self, cmds: torch.Tensor, params: TensorDict = None):
+        """Rotor lag model. All ops are elementwise, so ``cmds`` and every entry of
+        ``params`` may carry arbitrary leading batch dims (``[*batch, num_rotors]``).
+
+        ``params`` (see :func:`rotor_group_params`) replaces the module's own
+        parameters -- this is what ``tensordict.nn.make_functional`` + nested
+        ``vmap`` used to do before that API was removed from tensordict. The
+        ``throttle`` entry is updated **in place**, as before.
+        """
+        p = params if params is not None else self._own_params()
+        throttle = p["throttle"]
         target_throttle = self.f_inv(torch.clamp((cmds + 1) / 2, 0, 1))
 
-        tau = torch.where(target_throttle > self.throttle, self.tau_up, self.tau_down)
+        tau = torch.where(target_throttle > throttle, p["tau_up"], p["tau_down"])
         tau = torch.clamp(tau, 0, 1)
-        self.throttle.add_(tau * (target_throttle - self.throttle))
+        throttle.add_(tau * (target_throttle - throttle))
 
-        noise = torch.randn_like(self.throttle) * self.noise_scale * 0.
-        t = torch.clamp(self.f(self.throttle) + noise, 0., 1.)
-        thrusts = t * self.KF
-        moments = (t * self.KM) * -self.directions
+        noise = torch.randn_like(throttle) * self.noise_scale * 0.
+        t = torch.clamp(self.f(throttle) + noise, 0., 1.)
+        thrusts = t * p["KF"]
+        moments = (t * p["KM"]) * -p["directions"]
 
         return thrusts, moments
+
+    def _own_params(self) -> dict:
+        return {k: v.data for k, v in self.named_parameters()}
+
+
+def rotor_group_params(rotors: RotorGroup) -> TensorDict:
+    """The rotor group's parameters as a batch-less TensorDict (KF, KM, throttle,
+    directions, tau_up, tau_down) -- ``.expand(shape).clone()`` it to get one
+    independent set per drone, then pass it as ``rotors(cmds, params)``."""
+    return TensorDict({k: v.data.clone() for k, v in rotors.named_parameters()}, [])
